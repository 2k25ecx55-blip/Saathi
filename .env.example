# Base URL for local or remote Ollama server
OLLAMA_BASE_URL=http://localhost:11434

# Recommended models:
# - qwen2.5:7b (High precision JSON & multilingual English, Hindi, Tamil)
# - llama3.2-vision (if you want local image OCR directly in Ollama)
# - llama3.2, mistral
OLLAMA_MODEL=qwen2.5:7b
